# Database: PostgreSQL connection string
# Example: postgres://user:password@localhost:5432/healthonyx?sslmode=disable
DATABASE_URL=postgres://healthonyx:healthonyx@localhost:5432/healthonyx?sslmode=disable

# JWT signing secret - use a long random string in production
JWT_SECRET=change-me-to-a-secure-random-string

# Server port
PORT=8080

# CORS allowed origins (comma-separated). Default: http://localhost:4200
# CORS_ORIGINS=http://localhost:4200,http://localhost:3000

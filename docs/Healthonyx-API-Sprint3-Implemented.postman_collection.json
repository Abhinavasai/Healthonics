        {
          "name": "POST /api/login (patient demo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('patient login has token', function () { pm.expect(json.token).to.be.a('string'); });",
                  "pm.collectionVariables.set('patientToken', json.token);",
                  "if (json.user && json.user.id) pm.collectionVariables.set('patientUserId', json.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{patientEmail}}\",\n  \"password\": \"{{patientPassword}}\"\n}"
            },
            "url": {

    {
      "name": "Geo and Doctor Discovery",
      "item": [
        {
          "name": "GET /api/geocode",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/geocode?q={{geoQuery}}&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "geocode"],
              "query": [
                { "key": "q", "value": "{{geoQuery}}" },
                { "key": "limit", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "GET /api/hospitals/near",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.hospitals && j.hospitals[0] && j.hospitals[0].id) {",
                  "  pm.collectionVariables.set('hospitalId', j.hospitals[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/hospitals/near?lat={{lat}}&lng={{lng}}&radius_km=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hospitals", "near"],
              "query": [
                { "key": "lat", "value": "{{lat}}" },
                { "key": "lng", "value": "{{lng}}" },
                { "key": "radius_km", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "GET /api/doctors/search",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/doctors/search?lat={{lat}}&lng={{lng}}&radius_km=30&specialization=Internal%20Medicine",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors", "search"],
              "query": [
                { "key": "lat", "value": "{{lat}}" },
                { "key": "lng", "value": "{{lng}}" },
                { "key": "radius_km", "value": "30" },
                { "key": "specialization", "value": "Internal Medicine" }
              ]
            }
          }
        },

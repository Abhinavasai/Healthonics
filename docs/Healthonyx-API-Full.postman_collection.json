            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }] },
            "url": "http://{{baseUrl}}/api/patients/{{patientId}}/files"
          }
        },
        {
          "name": "POST /api/patients/{{patientId}}/prescriptions (doctor) (set prescriptionId)",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{doctorToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"medication_name\": \"Amoxicillin\",\n  \"dosage\": \"500mg\",\n  \"frequency\": \"twice daily\",\n  \"duration_days\": 5,\n  \"instructions\": \"Take after food\"\n}"
            },
            "url": "http://{{baseUrl}}/api/patients/{{patientId}}/prescriptions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json && json.id) {",
                  "    pm.collectionVariables.set('prescriptionId', json.id);",
                  "    pm.environment.set('prescriptionId', json.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/patients/{{patientId}}/prescriptions",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }] },
            "url": "http://{{baseUrl}}/api/patients/{{patientId}}/prescriptions"
          }
        },
        {
          "name": "PATCH /api/prescriptions/{{prescriptionId}}/revoke",
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{doctorToken}}", "type": "string" }] },
            "url": "http://{{baseUrl}}/api/prescriptions/{{prescriptionId}}/revoke"
          }
        }
      ]
    },
    {
      "name": "05 - Messaging + Notifications",
      "item": [

{
  "info": {
    "name": "Healthonyx API - Full Feature Coverage",
    "_postman_id": "2f0b1f3d-f67f-4576-bcd2-7d0de1f8d4a7",
    "description": "Comprehensive API collection for Healthonyx feature testing across auth, dashboards, find-care, appointments, documents/files, prescriptions, messaging, notifications, and admin endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "localhost:8080" },
    { "key": "patientEmail", "value": "patient@healthonyx.demo" },
    { "key": "patientPassword", "value": "patient123" },
    { "key": "doctorEmail", "value": "doctor@healthonyx.demo" },
    { "key": "doctorPassword", "value": "doctor123" },
    { "key": "adminEmail", "value": "admin@healthonyx.demo" },
    { "key": "adminPassword", "value": "admin123" },
    { "key": "patientToken", "value": "" },
    { "key": "doctorToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "doctorId", "value": "" },
    { "key": "patientId", "value": "" },
    { "key": "appointmentId", "value": "" },
    { "key": "threadId", "value": "" },
    { "key": "documentId", "value": "" },
    { "key": "fileId", "value": "" },
    { "key": "prescriptionId", "value": "" },
    { "key": "slotId", "value": "" },
    { "key": "query", "value": "Gainesville" },
    { "key": "lat", "value": "29.6516" },
    { "key": "lng", "value": "-82.3248" }
  ],
  "item": [
    {
      "name": "00 - Smoke (Runnable)",
      "item": [
        {
          "name": "GET /health",
          "request": { "method": "GET", "url": "http://{{baseUrl}}/health" }
        },
        {
          "name": "POST /api/login (patient)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{patientEmail}}\",\n  \"password\": \"{{patientPassword}}\"\n}"
            },
            "url": "http://{{baseUrl}}/api/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('patient token exists', function () { pm.expect(json.token).to.be.a('string'); });",
                  "pm.collectionVariables.set('patientToken', json.token);",
                  "if (json.user && json.user.id) pm.collectionVariables.set('patientId', json.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/login (doctor)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{doctorEmail}}\",\n  \"password\": \"{{doctorPassword}}\"\n}"
            },
            "url": "http://{{baseUrl}}/api/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('doctor token exists', function () { pm.expect(json.token).to.be.a('string'); });",
                  "pm.collectionVariables.set('doctorToken', json.token);",
                  "if (json.user && json.user.id) pm.collectionVariables.set('doctorId', json.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/login (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "http://{{baseUrl}}/api/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('admin token exists', function () { pm.expect(json.token).to.be.a('string'); });",
                  "pm.collectionVariables.set('adminToken', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/bootstrap",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": "http://{{baseUrl}}/api/bootstrap"
          }
        }
      ]
    },
    {
      "name": "01 - Dashboards",
      "item": [
        { "name": "GET /api/patient/dashboard/summary", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }], "url": "http://{{baseUrl}}/api/patient/dashboard/summary" } },
        { "name": "GET /api/doctor/dashboard/summary", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{doctorToken}}" }], "url": "http://{{baseUrl}}/api/doctor/dashboard/summary" } }
      ]
    },
    {
      "name": "02 - Find Care + Slots",
      "item": [
        { "name": "GET /api/geocode", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }], "url": "http://{{baseUrl}}/api/geocode?q={{query}}&limit=3" } },
        { "name": "GET /api/hospitals/near", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }], "url": "http://{{baseUrl}}/api/hospitals/near?lat={{lat}}&lng={{lng}}&radiusKm=10&limit=5" } },
        { "name": "GET /api/doctors/search", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }], "url": "http://{{baseUrl}}/api/doctors/search?lat={{lat}}&lng={{lng}}&radiusKm=10&limit=5" } },
        { "name": "POST /api/doctor/slots", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{doctorToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"start_at\": \"2026-06-01T10:00:00Z\",\n  \"end_at\": \"2026-06-01T10:20:00Z\"\n}" }, "url": "http://{{baseUrl}}/api/doctor/slots" } },
        { "name": "GET /api/doctors/{{doctorId}}/slots", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }], "url": "http://{{baseUrl}}/api/doctors/{{doctorId}}/slots" } }
      ]
    },
    {
      "name": "03 - Appointments + Comments",
      "item": [
        { "name": "POST /api/appointments", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"doctor_id\": \"{{doctorId}}\",\n  \"starts_at\": \"2026-06-01T11:00:00Z\",\n  \"ends_at\": \"2026-06-01T11:20:00Z\",\n  \"reason\": \"Follow-up\"\n}" }, "url": "http://{{baseUrl}}/api/appointments" } },
        { "name": "GET /api/appointments/patient", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }], "url": "http://{{baseUrl}}/api/appointments/patient" } },
        { "name": "GET /api/appointments/doctor", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{doctorToken}}" }], "url": "http://{{baseUrl}}/api/appointments/doctor" } },
        { "name": "PATCH /api/appointments/{{appointmentId}}/status", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{doctorToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"completed\"\n}" }, "url": "http://{{baseUrl}}/api/appointments/{{appointmentId}}/status" } },
        { "name": "GET /api/appointments/{{appointmentId}}/activity", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{doctorToken}}" }], "url": "http://{{baseUrl}}/api/appointments/{{appointmentId}}/activity" } },
        { "name": "POST /api/appointments/{{appointmentId}}/comments", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{doctorToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"body\": \"Patient follow-up note\"\n}" }, "url": "http://{{baseUrl}}/api/appointments/{{appointmentId}}/comments" } }
      ]
    },
    {
      "name": "04 - Documents + Files + Prescriptions",
      "item": [
        { "name": "GET /api/documents", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }], "url": "http://{{baseUrl}}/api/documents" } },
        { "name": "GET /api/doctor/documents", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{doctorToken}}" }], "url": "http://{{baseUrl}}/api/doctor/documents" } },
        { "name": "POST /api/doctor/documents/{{documentId}}/summarize", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{doctorToken}}" }], "url": "http://{{baseUrl}}/api/doctor/documents/{{documentId}}/summarize" } },
        { "name": "GET /api/patients/{{patientId}}/files", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }], "url": "http://{{baseUrl}}/api/patients/{{patientId}}/files" } },
        { "name": "GET /api/patients/{{patientId}}/prescriptions", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }], "url": "http://{{baseUrl}}/api/patients/{{patientId}}/prescriptions" } },
        { "name": "PATCH /api/prescriptions/{{prescriptionId}}/revoke", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{doctorToken}}" }], "url": "http://{{baseUrl}}/api/prescriptions/{{prescriptionId}}/revoke" } }
      ]
    },
    {
      "name": "05 - Messaging + Notifications",
      "item": [
        { "name": "GET /api/messages/unread", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }], "url": "http://{{baseUrl}}/api/messages/unread" } },
        { "name": "GET /api/messages/threads", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }], "url": "http://{{baseUrl}}/api/messages/threads" } },
        { "name": "POST /api/messages/threads/{{threadId}}/messages", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"body\": \"Hello doctor\"\n}" }, "url": "http://{{baseUrl}}/api/messages/threads/{{threadId}}/messages" } },
        { "name": "GET /api/notifications", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }], "url": "http://{{baseUrl}}/api/notifications" } }
      ]
    },
    {
      "name": "06 - Admin",
      "item": [
        { "name": "GET /api/admin", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "http://{{baseUrl}}/api/admin" } },
        { "name": "GET /api/admin/audit-log", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "http://{{baseUrl}}/api/admin/audit-log" } },
        { "name": "GET /api/admin/knowledge-docs", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "http://{{baseUrl}}/api/admin/knowledge-docs" } },
        { "name": "POST /api/admin/knowledge-docs", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Hypertension Guideline\",\n  \"body\": \"Content...\"\n}" }, "url": "http://{{baseUrl}}/api/admin/knowledge-docs" } }
      ]
    }
  ]
}

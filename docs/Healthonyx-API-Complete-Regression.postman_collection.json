          "name": "POST /api/login (patient)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('patientToken', j.token);",
                  "pm.collectionVariables.set('patientUserId', j.user.id);"

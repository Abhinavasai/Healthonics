    {
      "name": "Geo and Slots",
      "item": [
        {
          "name": "GET /api/geocode",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patientToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/geocode?q={{geoQuery}}&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "geocode"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "{{geoQuery}}"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "GET /api/hospitals/near",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patientToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hospitals/near?lat={{lat}}&lng={{lng}}&radius_km=25",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hospitals",
                "near"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "{{lat}}"
                },
                {
                  "key": "lng",
                  "value": "{{lng}}"
                },
                {
                  "key": "radius_km",
                  "value": "25"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test('hospitals is array', function () { pm.expect(j.hospitals).to.be.an('array'); });",
                  "if (j.hospitals && j.hospitals.length > 0) {",
                  "  pm.collectionVariables.set('hospitalId', j.hospitals[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/doctors/search",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patientToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/doctors/search?lat={{lat}}&lng={{lng}}&radius_km=25&specialization=Internal%20Medicine",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "doctors",
                "search"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "{{lat}}"
                },
                {
                  "key": "lng",
                  "value": "{{lng}}"
                },
                {
                  "key": "radius_km",
                  "value": "25"
                },
                {
                  "key": "specialization",
                  "value": "Internal Medicine"
                }
              ]
            }
          }
        },
